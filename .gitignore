# Environment / credentials — never commit real keys
.env
auth.json

# Runtime state (probe results / ratings cache) — regenerated on start
router_state.json
token_caps_state.json
rate_limits_state.json
gi_overrides.json

# Opt-in TBF learning telemetry (RATE_BUCKET_CSV_ENABLED)
rate_bucket_events.csv

# Persistent response cache (CACHE_PERSIST=1) — can contain real prompt/response
# content, never commit it
cache.db

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/
venv/
env/

# Git worktrees (local isolation)
.worktrees/

# Local agent design/plan docs (not part of the shipped product)
docs/superpowers/

# Raw GI leaderboard dumps (regenerate; see data/gi_sources/README.md)
data/gi_sources/*.json
!data/gi_sources/README.md

# IDE
.cursor/
.vscode/
.idea/
*.swp
*.swo
router.log
.claude/settings.json
